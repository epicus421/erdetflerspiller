[physics]

3d/run_on_separate_thread=true
3d/physics_engine="Jolt Physics"

[rendering]

occlusion_culling/bvh_build_quality=1
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_s3tc_bptc=true
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=1024
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
shader_compiler/shader_cache/strip_debug=true
global_illumination/gi/use_half_resolution=true
environment/ssao/quality=0
environment/ssil/quality=0
scaling_3d/scale=0.5
textures/decals/filter=0
textures/light_projectors/filter=0
environment/glow/upscale_mode=0
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
occlusion_culling/use_occlusion_culling=true
lights_and_shadows/positional_shadow/atlas_size=2048
limits/per_object_max_lights=4

[steam]

initialization/app_data/app_type=0
initialization/app_data/app_id=4887360
initialization/app_data/demo_id=0
initialization/app_data/playtest_id=0
initialization/app_data/tool_id=0
initialization/processes/initialize_on_startup=false
initialization/processes/embed_callbacks=false
multiplayer_peer/max_channels=4
