offer_dialogue = ["Jeg hørte noen rykter fra en liten fugl at du har behov for litt penger.", "De forbanna steinene tok capsen min...", "Den uvurderlige Peak Performance-capsen min.", "Få tilbake capsen min, så lover jeg at du skal få en liten slant for arbeidet.", "Om ikke jeg tar feil, sitter de nok i garasjen sin inneklemt i et av Kratergatas mange ekle hjørner."]
