[resource]
script = ExtResource("2")
quest_id = "SCHOLARSHIP_APPLICATION"
name = "Stipend"
description = "Søk stipend hos Lånekassa"
brief_description = "Det finnes kanskje måter å skaffe mer penger på."
required_quest_ids = ["GRANDPA_DISAPPOINTMENT"]
objectives = [SubResource("Resource_fdgti"), SubResource("Resource_b64h0")]
reward_items = ["approved_application"]
unlock_quests = ["BANK_DEPOSIT"]
offer_dialogue = ["Eg er lei av folk som sit og snakkar om at Lånekassen bryr seg ikkje og fikser ingenting.", "Du veit ikkje kva du snakkar om.", "Me sit her kvar dag, behandlar søknadar og held systemet i gang.", "Du trur det er lett? Prøv å handtere tusen studentar som masar om stipend samtidig.", "Stasjonen er til høyre for deg. Fyll ut og send inn."]
completion_dialogue = ["Godkjent.", "Her er søknaden din."]
